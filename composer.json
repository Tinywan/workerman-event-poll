{
    "name": "tinywan/workerman-event-poll",
    "description": "Workerman 5.x event loop driver based on PHP 8.6 native Io\\Poll API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "workerman",
        "event-loop",
        "io-poll",
        "epoll",
        "kqueue",
        "async"
    ],
    "authors": [
        {
            "name": "Tinywan",
            "email": "756684177@qq.com"
        }
    ],
    "require": {
        "php": ">=8.6",
        "workerman/workerman": "^5.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.0",
        "pestphp/pest": "^5.0"
    },
    "suggest": {
        "ext-pcntl": "Required by Workerman on POSIX systems",
        "ext-posix": "Required by Workerman on POSIX systems"
    },
    "autoload": {
        "psr-4": {
            "Workerman\\Events\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "carthage-software/mago": true,
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "format:check": "mago format --check",
        "format": "mago format",
        "lint": "mago lint",
        "analyse": "mago analyze",
        "test": "pest",
        "check": [
            "@format:check",
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
